      <robot_param>robot_description</robot_param>
      <parameters>package://fr3wml_ros2_control/config/robot_params.yaml</parameters>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>fr3wml</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>100</update_rate>
      <joint_name>j1</joint_name>
      <joint_name>j2</joint_name>
      <joint_name>j3</joint_name>
      <joint_name>j4</joint_name>
      <joint_name>j5</joint_name>
      <joint_name>j6</joint_name>
    </plugin>
  </gazebo>

